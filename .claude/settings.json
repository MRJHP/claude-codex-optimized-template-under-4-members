{
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv sync*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/session-start-reminders.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/agent-router.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/check-codex-before-write.py"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/check-codex-after-plan.py"
          }
        ]
      },
      {
        "matcher": "mcp__codex__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/log-codex-call.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/post-implementation-review.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/post-test-analysis.py"
          }
        ]
      },
      {
        "matcher": "mcp__codex__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/log-codex-call.py"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__codex__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/log-codex-call.py"
          }
        ]
      }
    ]
  }
}
